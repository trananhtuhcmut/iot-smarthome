# Local Mosquitto Broker
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883

# CoreIOT Cloud Gateway (Lấy Access Token từ thiết bị loại Gateway trên CoreIOT)
COREIOT_HOST=app.coreiot.io
COREIOT_PORT=1883
COREIOT_TOKEN=DIEN_ACCESS_TOKEN_GATEWAY_VAO_DAY

# Đường dẫn file SQLite lưu đệm offline
SQLITE_DB_PATH=gateway_buffer.db

# --- Edge AI (Giai đoạn 4: T09 + N04) ---
# 0 = Webcam laptop | Hoặc URL IP Camera / đường dẫn video .mp4 để benchmark
CAMERA_SOURCE=0
# cuda = chạy trên GPU RTX 4050 | cpu = chạy trên CPU (dùng lúc đo so sánh FPS)
AI_DEVICE=cuda
PERSON_MODEL_PATH=yolo11n.pt
# Khe cắm Plug-and-Play cho model báo cháy: để trống = chỉ chạy bắt người
# Khi train xong, đổi thành: weights/fire_best.pt
FIRE_MODEL_PATH=
AI_STREAM_PORT=8001